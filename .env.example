# Copy this file to `.env.local` and fill in the values from your Supabase project.
# `.env.local` is gitignored — never commit real keys.
#
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: The service-role key and the Resend API key are NEVER placed here.
# They live only in Supabase Edge Function secrets (see SETUP.md).
