# Copy this file to `.env.local` and fill in the values from your Supabase project.
# `.env.local` is gitignored — never commit real keys.
#
# Supabase Dashboard → Settings → Data API (URL) and Settings → API Keys.
#
# VITE_SUPABASE_URL      — your Project URL, e.g. https://<ref>.supabase.co
# VITE_SUPABASE_ANON_KEY — the "Publishable key" (sb_publishable_...), the
#                          public client key. (On older projects this is the
#                          "anon public" key.) Safe in the browser; RLS
#                          protects your data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NEVER place the Secret key (sb_secret_...) / service-role key or the Resend
# API key here. Those live only in Supabase Edge Function secrets (see SETUP.md).
